<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>ErneyTranslateTool</RootNamespace>
    <AssemblyName>ErneyTranslateTool</AssemblyName>
    <Version>1.0.36</Version>
    <Authors>Erney White</Authors>
    <Company>Erney White</Company>
    <Product>Erney's Translate Tool</Product>
    <Description>Real-time screen OCR translator for gaming</Description>
    <Copyright>Copyright © 2026 Erney White</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Icons\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Drop .NET satellite resource bundles for languages we don't ship UI in -->
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DeepL.net" Version="1.10.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="2.0.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />

    <!-- PaddleOCR (alternative engine for stylized / small fonts) -->
    <PackageReference Include="Sdcb.PaddleOCR" Version="3.0.1" />
    <PackageReference Include="Sdcb.PaddleOCR.Models.Online" Version="3.0.1" />
    <!-- shortcut: Models.Online 3.0.1 pulls SharpCompress 0.40.0 (NU1902,
         GHSA-6c8g-7p36-r338, zip slip). Pinning 0.48.1 breaks model download
         at runtime (MissingMethodException in ArchiveFactory.Open), so we
         keep 0.40.0: archives only come from the fixed PaddleOCR model URLs.
         Goes away with the PaddleOCR 3.3.1 upgrade, which needs a re-test of
         grouping on real games. -->

    <PackageReference Include="Sdcb.PaddleInference.runtime.win64.mkl" Version="3.1.0.54" />
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ErneyTranslateTool.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\*.png" />
    <Resource Include="Resources\Icons\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="tessdata\*.traineddata" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
