<UserControl x:Class="ErneyTranslateTool.Views.Controls.MaskedSecretBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="32" d:DesignWidth="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- v1.0.19 rewrite: PasswordBox + TextBox with code-behind sync.
             Replaces the previous "two TextBoxes with bullet-character
             rendering" trick which had subtle bugs around the eye-toggle
             not actually hiding the value (user-reported in v1.0.18).
             PasswordBox is the canonical WPF masked input — its built-in
             rendering can't get out of sync with the Secret value, the
             only thing the code-behind has to do is keep .Password
             two-way-aligned with the Secret dependency property. -->
        <PasswordBox x:Name="MaskedBox"
                     Grid.Column="0"
                     FontFamily="Consolas"
                     PasswordChar="•"
                     Visibility="Visible"/>

        <TextBox x:Name="PlainBox"
                 Grid.Column="0"
                 FontFamily="Consolas"
                 Visibility="Collapsed"/>

        <!-- Eye toggle: shows the value while held checked. Tooltip changes
             to reflect what clicking will do. -->
        <ToggleButton x:Name="RevealToggle"
                      Grid.Column="1"
                      Margin="6,0,0,0"
                      Padding="10,6"
                      Width="44"
                      Background="Transparent"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      Cursor="Hand"
                      Checked="OnRevealChanged"
                      Unchecked="OnRevealChanged"
                      ToolTip="Показать/скрыть значение">
            <TextBlock x:Name="EyeIcon" Text="👁" FontSize="14"/>
        </ToggleButton>
    </Grid>
</UserControl>
