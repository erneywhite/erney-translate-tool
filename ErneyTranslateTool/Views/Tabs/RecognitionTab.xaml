<UserControl x:Class="ErneyTranslateTool.Views.Tabs.RecognitionTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{DynamicResource BackgroundBrush}">
    <!-- v1.0.31: OCR settings moved out of the Translation tab into their
         own sidebar entry (redesign step 2). Same SettingsViewModel. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,20">
        <StackPanel>
            <TextBlock Text="{DynamicResource Strings.Tab.Recognition}"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,20"/>

            <GroupBox Header="{DynamicResource Strings.TS.OcrSection}" Style="{DynamicResource DarkGroupBoxStyle}" Margin="0,0,0,15">
                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource Strings.TS.OcrEngine}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding OcrEngines}"
                              SelectedValue="{Binding SelectedOcrEngine}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="DisplayName"
                              Margin="0,0,0,10"/>

                    <Border Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,6"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"
                                     Fill="{Binding OcrStatusColor}"/>
                            <TextBlock Text="{Binding OcrStatus}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{DynamicResource Strings.TS.OcrLang}"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding OcrLanguages}"
                              SelectedItem="{Binding SelectedOcrLanguage}"
                              DisplayMemberPath="DisplayName"
                              Width="320" HorizontalAlignment="Left"
                              Margin="0,0,0,10"/>

                    <!-- Windows OCR specific help -->
                    <StackPanel Visibility="{Binding IsWindowsOcr, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Strings.TS.WindowsOcrHelp}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,8"/>
                        <Button Content="{DynamicResource Strings.TS.OpenWindowsLang}"
                                Command="{Binding OpenWindowsLanguageSettingsCommand}"
                                Padding="14,6" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Tesseract specific: catalog with download -->
                    <StackPanel Visibility="{Binding IsTesseract, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Strings.TS.TesseractHelp}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,8"/>

                        <CheckBox Content="{DynamicResource Strings.TS.TessdataBest}"
                                  IsChecked="{Binding UseBestTessdata}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource Strings.TS.TessdataBestHint}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="22,0,0,10"/>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                Background="{DynamicResource InputBackgroundBrush}" Padding="6">
                            <ItemsControl ItemsSource="{Binding TessdataCatalog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text=" — "
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Code}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontFamily="Consolas"/>
                                                <TextBlock Text="{Binding StatusText}"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           Margin="10,0,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SizeText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,0,8,0"/>

                                            <Grid Grid.Column="2">
                                                <Button Content="{DynamicResource Strings.TS.DownloadLang}"
                                                        Padding="10,4"
                                                        Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.DownloadLanguageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="{DynamicResource Strings.Common.Delete}"
                                                        Padding="10,4"
                                                        Background="Transparent"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        Command="{Binding DataContext.DeleteLanguageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- Paddle specific help -->
                    <StackPanel Visibility="{Binding IsPaddle, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Strings.TS.PaddleHelp}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,8"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{DynamicResource Strings.TS.SaveBtn}"
                        Command="{Binding SaveCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}"/>
                <TextBlock Text="{Binding SaveStatus}"
                           Foreground="{DynamicResource SuccessBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
