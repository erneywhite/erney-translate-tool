<UserControl x:Class="ErneyTranslateTool.Views.Tabs.AppSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ErneyTranslateTool.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,20">
        <StackPanel>
            <DockPanel Margin="0,0,0,5" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Strings.AppSettings.Title}"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <!-- v1.0.32: no Save button — SettingsViewModel auto-saves. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <TextBlock Text="{Binding SaveStatus}" FontSize="12" Margin="0,0,12,0"
                               Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Text="{DynamicResource Strings.OS.AppliedInstantly}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{DynamicResource Strings.AppSettings.Subtitle}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"/>

            <GroupBox Header="{DynamicResource Strings.OS.AppTheme}" Style="{DynamicResource DarkGroupBoxStyle}" Margin="0,0,0,15">
                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource Strings.OS.AppThemeHelp}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding AppThemes}"
                              SelectedValue="{Binding SelectedAppTheme}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="DisplayName"
                              Width="320" HorizontalAlignment="Left"
                              Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource Strings.OS.AppLanguage}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AppLanguages}"
                              SelectedValue="{Binding SelectedAppLanguage}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="DisplayName"
                              Width="320" HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource Strings.OS.Behavior}" Style="{DynamicResource DarkGroupBoxStyle}" Margin="0,0,0,15">
                <StackPanel Margin="5">
                    <CheckBox Content="{DynamicResource Strings.OS.CloseToTray}"
                              IsChecked="{Binding CloseToTray}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Strings.OS.CloseToTrayHint}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="22,0,0,10"/>
                    <CheckBox Content="{DynamicResource Strings.OS.CheckUpdates}"
                              IsChecked="{Binding CheckForUpdatesOnStartup}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,8"/>
                    <CheckBox Content="{DynamicResource Strings.OS.AutoStart}"
                              IsChecked="{Binding AutoStartWithWindows}"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Strings.OS.AutoStartHint}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="22,0,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource Strings.TS.Hotkeys}" Style="{DynamicResource DarkGroupBoxStyle}" Margin="0,0,0,15">
                <StackPanel Margin="5">
                    <!-- v1.0.14: HotkeyCaptureBox replaces the old plain TextBox.
                         Click → press combo → it's saved AND re-registered with
                         Win32 immediately (no restart needed — that was the
                         "I changed it but it doesn't work" v1.0.13 bug). -->
                    <TextBlock Text="{DynamicResource Strings.TS.HotkeysHelp}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Strings.TS.HotkeyToggle}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <controls:HotkeyCaptureBox Grid.Row="0" Grid.Column="1"
                                                   Hotkey="{Binding ToggleTranslationHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Strings.TS.HotkeyOverlay}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <controls:HotkeyCaptureBox Grid.Row="1" Grid.Column="1"
                                                   Hotkey="{Binding ToggleOverlayHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Strings.TS.HotkeyPause}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <controls:HotkeyCaptureBox Grid.Row="2" Grid.Column="1"
                                                   Hotkey="{Binding PauseTranslationHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource Strings.TS.Cache}" Style="{DynamicResource DarkGroupBoxStyle}" Margin="0,0,0,15">
                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource Strings.TS.CacheHelp}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Strings.TS.CacheLimit}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding CacheSizeOptions}"
                                  SelectedItem="{Binding SelectedCacheSizeOption}"
                                  DisplayMemberPath="DisplayName"
                                  Width="260"
                                  HorizontalAlignment="Left"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{DynamicResource Strings.TS.CacheCurrent}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding CacheStatsText}"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{DynamicResource Strings.Common.Refresh}"
                                Command="{Binding RefreshCacheStatsCommand}"
                                Padding="14,6" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource Strings.TS.ClearCache}"
                                Command="{Binding ClearCacheCommand}"
                                Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource Strings.OS.Diagnostics}" Style="{DynamicResource DarkGroupBoxStyle}" Margin="0,0,0,15">
                <StackPanel Margin="5">
                    <CheckBox Content="{DynamicResource Strings.OS.RecordOcr}"
                              IsChecked="{Binding RecordOcr}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource Strings.OS.RecordOcrHint}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" FontSize="11"
                               Margin="22,0,0,10"/>
                    <Button Content="{DynamicResource Strings.OS.OpenRecordings}"
                            Command="{Binding OpenOcrRecordingsCommand}"
                            Padding="14,6" HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
