<UserControl x:Class="ErneyTranslateTool.Views.Tabs.TranslationSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ErneyTranslateTool.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,20">
        <StackPanel>
            <DockPanel Margin="0,0,0,20" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Strings.TS.Title}"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <!-- v1.0.32: no Save button — SettingsViewModel auto-saves. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <TextBlock Text="{Binding SaveStatus}" FontSize="12" Margin="0,0,12,0"
                               Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Text="{DynamicResource Strings.OS.AppliedInstantly}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>

            <GroupBox Header="{DynamicResource Strings.TS.Service}" Style="{DynamicResource DarkGroupBoxStyle}" Margin="0,0,0,15">
                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource Strings.TS.SelectService}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Providers}"
                              SelectedValue="{Binding SelectedProvider}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="DisplayName"
                              Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding ProviderHelpText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,10"/>

                    <StackPanel Visibility="{Binding IsDeepL, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Strings.TS.DeepLKey}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <controls:MaskedSecretBox Secret="{Binding DeepLApiKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsMyMemory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Strings.TS.MyMemoryEmail}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding MyMemoryEmail, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsGoogleFree, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Strings.TS.GoogleHelp}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsLibre, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Strings.TS.LibreUrl}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding LibreUrl, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"
                                 Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource Strings.TS.LibreKey}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <controls:MaskedSecretBox Secret="{Binding LibreApiKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsOpenAI, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Strings.TS.OpenAIKey}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <controls:MaskedSecretBox Secret="{Binding OpenAIApiKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource Strings.TS.Model}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding OpenAIModel, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"
                                     Margin="0,0,8,0"
                                     ToolTip="{DynamicResource Strings.TS.ModelTextHint}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding OpenAIModelPresets}"
                                      SelectedItem="{Binding OpenAIModel, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{DynamicResource Strings.TS.ModelPresetsHint}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsAnthropic, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Strings.TS.AnthropicKey}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <controls:MaskedSecretBox Secret="{Binding AnthropicApiKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource Strings.TS.Model}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding AnthropicModel, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"
                                     Margin="0,0,8,0"
                                     ToolTip="{DynamicResource Strings.TS.ModelTextHint}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AnthropicModelPresets}"
                                      SelectedItem="{Binding AnthropicModel, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{DynamicResource Strings.TS.ModelPresetsHint}"/>
                        </Grid>
                    </StackPanel>

                    <!-- v1.0.18: Gemini section — same shape as OpenAI/Anthropic
                         (key field + model textbox + preset combo) so users
                         familiar with one configure the other in seconds. -->
                    <StackPanel Visibility="{Binding IsGemini, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Strings.TS.GeminiKey}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <controls:MaskedSecretBox Secret="{Binding GeminiApiKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource Strings.TS.Model}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding GeminiModel, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"
                                     Margin="0,0,8,0"
                                     ToolTip="{DynamicResource Strings.TS.ModelTextHint}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding GeminiModelPresets}"
                                      SelectedItem="{Binding GeminiModel, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{DynamicResource Strings.TS.ModelPresetsHint}"/>
                        </Grid>
                    </StackPanel>

                    <!-- v1.0.18: Groq section (GPT-OSS by default since v1.0.30). -->
                    <StackPanel Visibility="{Binding IsGroq, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Strings.TS.GroqKey}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <controls:MaskedSecretBox Secret="{Binding GroqApiKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource Strings.TS.Model}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding GroqModel, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"
                                     Margin="0,0,8,0"
                                     ToolTip="{DynamicResource Strings.TS.ModelTextHint}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding GroqModelPresets}"
                                      SelectedItem="{Binding GroqModel, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{DynamicResource Strings.TS.ModelPresetsHint}"/>
                        </Grid>
                    </StackPanel>

                    <!-- v1.0.34: any OpenAI-compatible server (Ollama, LM Studio,
                         OpenRouter, DeepSeek). Same translator as OpenAI in
                         compatibility mode; key optional. -->
                    <StackPanel Visibility="{Binding IsCustomLlm, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Strings.TS.Custom.Url}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding CustomLlmBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Strings.TS.Custom.Quick}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="Ollama" Padding="10,4" Margin="0,0,6,0"
                                    Command="{Binding SetCustomLlmUrlCommand}" CommandParameter="http://localhost:11434/v1"/>
                            <Button Content="LM Studio" Padding="10,4" Margin="0,0,6,0"
                                    Command="{Binding SetCustomLlmUrlCommand}" CommandParameter="http://localhost:1234/v1"/>
                            <Button Content="OpenRouter" Padding="10,4" Margin="0,0,6,0"
                                    Command="{Binding SetCustomLlmUrlCommand}" CommandParameter="https://openrouter.ai/api/v1"/>
                            <Button Content="DeepSeek" Padding="10,4"
                                    Command="{Binding SetCustomLlmUrlCommand}" CommandParameter="https://api.deepseek.com/v1"/>
                        </WrapPanel>
                        <TextBlock Text="{DynamicResource Strings.TS.Custom.Key}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <controls:MaskedSecretBox Secret="{Binding CustomLlmApiKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource Strings.TS.Model}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding CustomLlmModel, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"
                                     Margin="0,0,8,0"
                                     ToolTip="{DynamicResource Strings.TS.ModelTextHint}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding CustomLlmModels}"
                                      SelectedItem="{Binding CustomLlmModel, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{DynamicResource Strings.TS.Custom.ListHint}"/>
                        </Grid>
                        <Button Content="{DynamicResource Strings.TS.Custom.Fetch}"
                                Command="{Binding FetchCustomLlmModelsCommand}" Padding="12,5"
                                HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding CustomLlmModelsStatus}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Temperature + context controls — common to both LLM providers. -->
                    <StackPanel Visibility="{Binding IsLlm, Converter={StaticResource BoolToVis}}"
                                Margin="0,12,0,0">
                        <TextBlock Text="{DynamicResource Strings.TS.LlmHelp}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Strings.TS.Temperature}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       ToolTip="{DynamicResource Strings.TS.Temperature.Tooltip}"/>
                            <Slider Grid.Column="1"
                                    Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.1" TickPlacement="BottomRight" IsSnapToTickEnabled="True"
                                    Value="{Binding LlmTemperature}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding LlmTemperature, StringFormat={}{0:F2}}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <CheckBox Content="{DynamicResource Strings.TS.UseContext}"
                                  IsChecked="{Binding LlmUseContext}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,4"
                                  ToolTip="{DynamicResource Strings.TS.UseContext.Tooltip}"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Strings.TS.ContextSize}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       ToolTip="{DynamicResource Strings.TS.ContextSize.Tooltip}"/>
                            <Slider Grid.Column="1"
                                    Minimum="0" Maximum="10" SmallChange="1" LargeChange="2"
                                    TickFrequency="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True"
                                    Value="{Binding LlmContextSize}"
                                    IsEnabled="{Binding LlmUseContext}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding LlmContextSize}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- v1.0.15: streaming toggle. ON by default — the
                             typewriter effect is much more responsive UX
                             feeling for LLM providers. Off mostly for
                             debugging or in environments where SSE gets
                             buffered (some corporate proxies). -->
                        <CheckBox Content="{DynamicResource Strings.TS.UseStreaming}"
                                  IsChecked="{Binding UseStreamingLlm}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,10,0,4"
                                  ToolTip="{DynamicResource Strings.TS.UseStreaming.Tooltip}"/>
                    </StackPanel>

                    <Button Content="{DynamicResource Strings.TS.TestConnection}"
                            Command="{Binding TestProviderCommand}"
                            Padding="14,8" HorizontalAlignment="Left"
                            Margin="0,12,0,8"/>

                    <TextBlock Text="{Binding TestStatus}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource Strings.TS.Fallback}" Style="{DynamicResource DarkGroupBoxStyle}" Margin="0,0,0,15">
                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource Strings.TS.FallbackHelp}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding FallbackProviders}"
                              SelectedValue="{Binding SelectedFallbackProvider}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="DisplayName"
                              Width="380"
                              HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource Strings.TS.TargetLang}" Style="{DynamicResource DarkGroupBoxStyle}" Margin="0,0,0,15">
                <StackPanel Margin="5">
                    <ComboBox ItemsSource="{Binding TargetLanguages}"
                              SelectedItem="{Binding SelectedTargetLanguage}"
                              DisplayMemberPath="DisplayName"
                              Width="280" HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
